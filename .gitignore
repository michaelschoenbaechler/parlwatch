# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*
node_modules/

/.angular
/apps/*/.angular
/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/apps/*/coverage
/dist
.env
.env.local
.env.*.local
/platforms
/plugins
/apps/ionic/www
/apps/ionic/ios/App/fastlane/report.xml
/apps/ionic/ios/App/fastlane/Preview.html
/apps/ionic/ios/App/fastlane/test_output
/apps/ionic/ios/App/fastlane/screenshots
/apps/ionic/android/.gradle/
/apps/ionic/android/build/
/apps/ionic/android/app/build/
/apps/ionic/android/local.properties
/apps/ionic/android/app/google-services.json
/apps/ionic/android/fastlane/report.xml
/apps/ionic/android/fastlane/Preview.html
/apps/ionic/android/fastlane/test_output
/apps/ionic/android/fastlane/screenshots

# Android signing material is never committed
*.keystore
*.jks

# Generated by apps/ionic/scripts/copy-ionicons.mjs
apps/ionic/.ionicons/
