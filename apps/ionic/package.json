{
  "name": "@parlwatch/ionic",
  "version": "2026.4.1",
  "author": "Michael Schönbächler",
  "homepage": "https://github.com/michaelschoenbaechler",
  "description": "Easy access for everyone to parliamentary data",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/copy-ionicons.mjs",
    "prestart": "node scripts/copy-ionicons.mjs",
    "prebuild": "node scripts/copy-ionicons.mjs",
    "prebuild:prd": "node scripts/copy-ionicons.mjs",
    "pretest": "node scripts/copy-ionicons.mjs",
    "pretest:ci": "node scripts/copy-ionicons.mjs",
    "start": "ng serve",
    "build": "ng build",
    "build:prd": "ng build --configuration=production",
    "ios:sync": "npx cap sync ios",
    "ios:fastlane:install": "cd ios/App && bundle install",
    "ios:prepare": "npm run build:prd && npm run ios:sync",
    "ios:deploy:testflight": "npm run ios:prepare && cd ios/App && bundle exec fastlane deploy_testflight",
    "ios:deploy:appstore": "npm run ios:prepare && cd ios/App && bundle exec fastlane deploy_appstore",
    "lint": "ng lint && npx prettier -c \"src/**/*.{ts,html}\"",
    "lint:fix": "ng lint --fix",
    "prettier": "npm run prettier:fix",
    "prettier:fix": "npx prettier --write \"src/**/*.{ts,html}\"",
    "i18n:extract": "transloco-keys-manager extract --remove-extra-keys --sort",
    "i18n:find": "transloco-keys-manager find",
    "changelog:generate": "conventional-changelog -p angular",
    "test": "ng test",
    "test:ci": "ng test --browsers=ChromeHeadless --watch=false --code-coverage",
    "test:coverage": "ng test --code-coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.20",
    "@angular/platform-browser": "^21.2.4",
    "@angular/router": "^21.2.20",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/angular": "^8.8.18",
    "@ionic/core": "^8.8.1",
    "@ionic/storage-angular": "^4.0.0",
    "@jsverse/transloco": "^8.4.0",
    "@ngneat/until-destroy": "^10.0.0",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "ionicons": "^8.1.0",
    "lodash": "^4.18.1",
    "rxjs": "~7.8.1",
    "swissparl": "^0.6.2",
    "tslib": "^2.2.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular-devkit/build-angular": "^21.2.1",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "^21.2.21",
    "@angular/compiler": "^21.2.4",
    "@angular/compiler-cli": "^21.2.4",
    "@angular/language-service": "^21.2.20",
    "@capacitor/cli": "^8.5.0",
    "@ionic/angular-toolkit": "^12.3.0",
    "@jsverse/transloco-keys-manager": "^8.1.1",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "conventional-changelog": "^8.1.3",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "prettier": "^3.9.6",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3"
  }
}
