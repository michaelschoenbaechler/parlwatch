{
  "root": true,
  "ignorePatterns": ["projects/**/*"],
  "settings": {
    "import/resolver": {
      "typescript": {}
    }
  },
  "overrides": [
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": ["tsconfig.json"],
        "createDefaultProgram": true
      },
      "extends": [
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates",
        "plugin:import/recommended",
        "plugin:import/typescript",
        "plugin:jsdoc/recommended-typescript"
      ],
      "settings": {
        "import/resolver": {
          "typescript": true,
          "node": true
        }
      },
      "plugins": ["import", "jsdoc", "unused-imports"],
      "rules": {
        "@angular-eslint/component-class-suffix": [
          "error",
          {
            "suffixes": ["Page", "Component"]
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "app",
            "style": "kebab-case"
          }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "app",
            "style": "camelCase"
          }
        ],
        "import/newline-after-import": "error",
        "import/order": [
          "error",
          {
            "groups": [
              "builtin",
              "external",
              "internal",
              "parent",
              "sibling",
              "index"
            ],
            "pathGroups": [{ "pattern": "@parlwatch/**", "group": "internal" }],
            "pathGroupsExcludedImportTypes": ["builtin"]
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\.?/(\\.\\./)*shared/",
                "message": "Import shared code through @parlwatch/shared/… instead of a relative path."
              },
              {
                "regex": "^@parlwatch/shared/(swissparl/|[^/]+/(?!testing/fixtures/)[^/]+/)",
                "message": "Import from the folder barrel, e.g. @parlwatch/shared/common/models, not from a file inside it."
              }
            ]
          }
        ],
        "unused-imports/no-unused-imports": "error"
      }
    },
    {
      "files": ["src/app/shared/common/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(common|open-parl-data|parliament|swissparl)/",
                "message": "Import another shared area through @parlwatch/shared/… instead of a relative path."
              },
              {
                "regex": "^@parlwatch/shared/(swissparl/|[^/]+/(?!testing/fixtures/)[^/]+/)",
                "message": "Import from the folder barrel, e.g. @parlwatch/shared/common/models, not from a file inside it."
              },
              {
                "regex": "^@parlwatch/shared/common(/|$)",
                "message": "Inside a shared area import siblings relatively; its own barrels would create an import cycle."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/shared/open-parl-data/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(common|open-parl-data|parliament|swissparl)/",
                "message": "Import another shared area through @parlwatch/shared/… instead of a relative path."
              },
              {
                "regex": "^@parlwatch/shared/(swissparl/|[^/]+/(?!testing/fixtures/)[^/]+/)",
                "message": "Import from the folder barrel, e.g. @parlwatch/shared/common/models, not from a file inside it."
              },
              {
                "regex": "^@parlwatch/shared/open-parl-data(/|$)",
                "message": "Inside a shared area import siblings relatively; its own barrels would create an import cycle."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/shared/parliament/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(common|open-parl-data|parliament|swissparl)/",
                "message": "Import another shared area through @parlwatch/shared/… instead of a relative path."
              },
              {
                "regex": "^@parlwatch/shared/(swissparl/|[^/]+/(?!testing/fixtures/)[^/]+/)",
                "message": "Import from the folder barrel, e.g. @parlwatch/shared/common/models, not from a file inside it."
              },
              {
                "regex": "^@parlwatch/shared/parliament(/|$)",
                "message": "Inside a shared area import siblings relatively; its own barrels would create an import cycle."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/shared/swissparl/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(common|open-parl-data|parliament|swissparl)/",
                "message": "Import another shared area through @parlwatch/shared/… instead of a relative path."
              },
              {
                "regex": "^@parlwatch/shared/(swissparl/|[^/]+/(?!testing/fixtures/)[^/]+/)",
                "message": "Import from the folder barrel, e.g. @parlwatch/shared/common/models, not from a file inside it."
              },
              {
                "regex": "^@parlwatch/shared/swissparl(/|$)",
                "message": "Inside a shared area import siblings relatively; its own barrels would create an import cycle."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@angular-eslint/template/recommended"],
      "rules": {
        "@angular-eslint/template/prefer-control-flow": "error"
      }
    }
  ]
}
